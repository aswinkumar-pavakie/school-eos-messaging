# ---- Database: the EXISTING School EOS Supabase PostgreSQL project ----
# This is NOT a new database. Use the same Supabase project Core
# (school-eos-backend) already connects to — copy the connection string from
# that project's own .env / Supabase dashboard -> Project Settings -> Database.
# Messaging owns its tables inside a dedicated `messaging` Postgres schema
# (see database/migrations/0001_messaging_schema.sql) — it never touches Core's
# `public` schema tables. Never run this repo's migrations against any database
# other than the real, approved Supabase project.
DATABASE_URL=

# ---- Redis: separate, ephemeral-only realtime coordination ----
# Local dev: `docker compose up redis` (see docker-compose.yml). Production:
# a real managed Redis instance.
REDIS_URL=redis://localhost:6379

# ---- Auth: verifies the SAME JWT Core issues, never issues its own ----
# Must be the exact value of Core's own JWT_ACCESS_SECRET — Messaging does not
# have a separate identity system (see auth/README.md).
JWT_ACCESS_SECRET=

# ---- Service-to-service auth for the new Core-side internal endpoints ----
# Must match the MESSAGING_INTERNAL_KEY configured on school-eos-backend's own
# new internal module (see core-integration/README.md). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MESSAGING_INTERNAL_KEY=
CORE_INTERNAL_BASE_URL=http://localhost:3000/internal/v1/messaging

PORT=3001

# ---- Optional — defaults shown; uncomment to override ----
# JWT_ACCESS_EXPIRES_IN=15m
# RATE_LIMIT_MESSAGE_PER_MINUTE=60
# RATE_LIMIT_REQUEST_PER_HOUR=10
# RATE_LIMIT_DIRECTORY_SEARCH_PER_MINUTE=30
# OUTBOX_POLL_INTERVAL_MS=2000
# OUTBOX_MAX_ATTEMPTS=8

# ---- Deferred (not required to boot; see README "Explicitly deferred") ----
# Object storage (attachments) — configure when that phase is built.
# ATTACHMENTS_STORAGE_PROVIDER=
# ATTACHMENTS_BUCKET=
# Push notifications (FCM/APNs) — configure when that phase is built.
# FCM_SERVICE_ACCOUNT_JSON=
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_PRIVATE_KEY=
